# ==============================================================================
# VozInbox Agent — environment configuration
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION
# ------------------------------------------------------------------------------
# Public origin used to build OAuth redirect URIs. Must match the Google
# "Authorized redirect URI" exactly.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. SUPABASE (database + auth + realtime)
#    Create a project at https://supabase.com, then:
#    Project Settings → API → copy the URL and the anon/publishable key.
#    Project Settings → API → copy the service_role key (SERVER ONLY).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SERVER ONLY. Never referenced by client code, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# 3. GOOGLE / GMAIL OAUTH
#    https://console.cloud.google.com → APIs & Services
#    • Enable "Gmail API"
#    • OAuth consent screen → add scope https://www.googleapis.com/auth/gmail.readonly
#    • Credentials → Create OAuth client ID → Web application
#    • Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/integrations/gmail/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: restrict connect to a Google Workspace domain. Leave blank to allow all.
GOOGLE_ALLOWED_WORKSPACE_DOMAIN=""

# ------------------------------------------------------------------------------
# 4. TOKEN ENCRYPTION
#    AES-256-GCM key used to encrypt OAuth refresh/access tokens at rest.
#    Generate with:  openssl rand -base64 32
# ------------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=""

# ------------------------------------------------------------------------------
# 5. AI PROVIDER (OpenAI-compatible chat completions with JSON/structured output)
#    Works with OpenAI, Azure OpenAI, OpenRouter, Groq, Together, vLLM, Ollama…
# ------------------------------------------------------------------------------
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
# Optional: separate (usually cheaper) model for the chat assistant + search parsing.
AI_CHAT_MODEL=""
# Optional: provider that supports strict json_schema response format.
# "auto" probes the provider; set to "json_object" for providers without json_schema.
AI_STRUCTURED_OUTPUT_MODE="auto"
AI_REQUEST_TIMEOUT_MS="45000"
# Hard cap on agent tool-calling depth (prevents uncontrolled recursion).
AI_MAX_TOOL_DEPTH="4"

# ------------------------------------------------------------------------------
# 6. AGENT BEHAVIOUR DEFAULTS (per-user values live in user_preferences)
# ------------------------------------------------------------------------------
AGENT_MAX_EMAILS_PER_SYNC="40"
AGENT_ANALYSIS_VERSION="1.0.0"
AGENT_CONFIDENCE_THRESHOLD_DEFAULT="0.90"

# ------------------------------------------------------------------------------
# 7. CRON / BACKGROUND SYNC (optional)
#    Protects /api/cron/* endpoints. Generate with: openssl rand -hex 32
# ------------------------------------------------------------------------------
CRON_SECRET=""

# ------------------------------------------------------------------------------
# 8. LOCAL DEVELOPMENT MODE (optional)
#    `auto` (default) → local mode only when Supabase env vars are absent AND
#    NODE_ENV !== production. Never use local mode in production.
#    Values: auto | on | off
# ------------------------------------------------------------------------------
VOZINBOX_LOCAL_MODE="auto"
